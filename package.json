{
  "name": "notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "nodemon server/app.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "migrate": "knex migrate:latest --knexfile server/database/knexfile.js",
    "rollback": "knex migrate:rollback --knexfile server/database/knexfile.js",
    "seed": "knex seed:run --knexfile server/database/knexfile.js",
    "test": "vitest"
  },
  "dependencies": {
    "express": "^5.2.1",
    "knex": "^3.2.10",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
